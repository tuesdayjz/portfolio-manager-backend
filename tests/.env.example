# Supabase テスト用の切り替え。
# ローカルの integration test では、このファイルを tests/.env にコピーする。
# tests/.env は git-ignored。実際のテスト用パスワードはここにだけ置く。
RUN_SUPABASE_CONNECTION_TESTS=false

# user isolation RLS tests の実行対象を切り替える。
# false = mock user の RLS tests を実行
# true = 下の SUPABASE_TEST_USER_* を使って real user の RLS tests を実行
RUN_SUPABASE_REAL_USER=false

# true の場合、holding を持たない real user に一時 holding を作成する。
# テストが作成した row は終了時に削除する。
RUN_SUPABASE_REAL_USER_BOOTSTRAP_DATA=false

# Real-user RLS integration tests。
# 実際のパスワードはコミットしない。ローカルの tests/.env にだけ置く。
SUPABASE_TEST_USER_EMAIL=
SUPABASE_TEST_USER_PASSWORD=
SUPABASE_SECOND_TEST_USER_EMAIL=
SUPABASE_SECOND_TEST_USER_PASSWORD=
