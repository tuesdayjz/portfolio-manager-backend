# Flask
FLASK_APP=wsgi.py
FLASK_ENV=development
# 5000 は macOS の AirPlay レシーバーが占有していて 403 になる
FLASK_RUN_PORT=5001

# 本番では必ずランダムな値に差し替えること
SECRET_KEY=dev-secret-key-change-me

# Supabase
# Dashboard > Project Settings > Database > Connection string から取得し、
# ドライバに psycopg (v3) を指定する。Supabase は SSL 必須。
DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# テスト用 DB。未設定ならインメモリ SQLite を使う。
# TEST_DATABASE_URL=
