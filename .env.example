# Flask
FLASK_APP=wsgi.py
FLASK_ENV=development
# 5000 は macOS の AirPlay レシーバーが占有していて 403 になる
FLASK_RUN_PORT=5001

# 本番では必ずランダムな値に差し替えること
SECRET_KEY=dev-secret-key-change-me

# Supabase
# Dashboard > Connect > Direct Connection から取得した connection string をもとに、
# ローカル実行では IPv4 pooler を使う。ドライバは psycopg (v3) を指定する。
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Unit test 用 DB。未設定ならインメモリ SQLite を使う。
TEST_DATABASE_URL=sqlite+pysqlite:///:memory:
SUPABASE_URL=https://gvtxkyimbroikdfjsacb.supabase.co
SUPABASE_ANON_KEY=sb_publishable_KciV4GAk1YJW98w4Q947Gw_DXQ6IfFJ
# Never commit the real service role key. Put it only in local .env or GitHub Secrets.
SUPABASE_SERVICE_ROLE_KEY=
DEFAULT_BASE_CURRENCY=USD

# Real-user RLS integration tests
RUN_SUPABASE_REAL_USER_RLS_TESTS=false
SUPABASE_TEST_USER_EMAIL=
# Never commit real passwords. Put them only in local .env.
SUPABASE_TEST_USER_PASSWORD=
SUPABASE_SECOND_TEST_USER_EMAIL=
SUPABASE_SECOND_TEST_USER_PASSWORD=
