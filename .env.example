# Flask
FLASK_APP=wsgi.py
FLASK_ENV=development
# 5000 は macOS の AirPlay レシーバーが占有していて 403 になる
FLASK_RUN_PORT=5001

# 本番では必ずランダムな値に差し替えること
SECRET_KEY=dev-secret-key-change-me

# Supabase
SUPABASE_URL=https://gvtxkyimbroikdfjsacb.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DEFAULT_BASE_CURRENCY=JPY

# Real-user RLS integration tests
RUN_SUPABASE_REAL_USER_RLS_TESTS=false
SUPABASE_TEST_USER_EMAIL=
SUPABASE_TEST_USER_PASSWORD=
SUPABASE_SECOND_TEST_USER_EMAIL=
SUPABASE_SECOND_TEST_USER_PASSWORD=
